# RE-SEND environment. Copy to .env and fill in. NEVER commit real secrets.
# Every value below is a name only — no secret is checked into the repository.

# --- Core ---------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# PostgreSQL connection string. Managed by Render in deployment.
DATABASE_URL=

# --- Secrets ------------------------------------------------------------------
# Signs the session cookie (HMAC). Required in production. Generate a long
# random value, e.g. `openssl rand -base64 48`.
SESSION_SECRET=

# Encrypts sensitive fields (SEND needs, additional needs, case aims) and every
# stored document file. REQUIRED: the API will not start without it (tests use
# a built-in test key). At least 32 characters: `openssl rand -base64 32`.
# KEEP A COPY somewhere safe, apart from the database backups: without this key
# the encrypted data cannot be read, even from a backup.
ENCRYPTION_KEY=
# Only while rotating to a new key: the old one, so existing data still reads
# until the start-up pass has re-encrypted it. Remove it only after the log
# shows "encryption pass finished" with unreadable: 0 and failed: 0.
ENCRYPTION_KEY_PREVIOUS=

# The Claude API key for the AI job layer. Server-side only — never sent to the
# browser. Leave blank to run with AI features disabled.
ANTHROPIC_API_KEY=

# --- AI -----------------------------------------------------------------------
AI_ENABLED=true
AI_MAX_RETRIES=2

# --- Object storage -----------------------------------------------------------
# `local` writes under UPLOAD_DIR; `s3` talks to any S3-compatible endpoint.
STORAGE_PROVIDER=local
UPLOAD_DIR=.uploads
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --- Demo mode ----------------------------------------------------------------
# Local password login for the named demo accounts, so the system can be shown
# without a Microsoft tenant. MUST be false in production (startup fails
# otherwise). DEMO_PASSWORD is the shared password for the demo accounts.
DEMO_MODE=false
DEMO_PASSWORD=

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=info
